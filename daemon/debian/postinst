#!/bin/bash
set -e

# shellcheck source=/dev/null
. /usr/share/debconf/confmodule

export PATH=$PATH:/sbin:/usr/sbin:/bin:/usr/bin

case "$1" in
  configure)
    if ! getent group novium_daemon >/dev/null
    then
      addgroup --system --gid 25335 novium_daemon >/dev/null
    fi

    if ! getent passwd novium_daemon >/dev/null
    then
      adduser \
        --system \
        --disabled-login \
        --ingroup novium_daemon \
        --no-create-home \
        --home /nonexistent \
        --gecos "Novium Daemon" \
        --shell /bin/false \
        --uid 25335 \
        novium_daemon >/dev/null 2>&1
    fi

    adduser novium_daemon docker
    ;;
  *)
    echo "postinst called with unknown argument '$1'" 1>&2
    exit 1
    ;;
esac

systemctl --system daemon-reload >/dev/null || true
if systemctl is-enabled novium_daemon.service >/dev/null
then
    deb-systemd-invoke restart novium_daemon.service >/dev/null || true
fi

#DEBHELPER#


