#!/bin/bash
set -e

# shellcheck source=/dev/null
. /usr/share/debconf/confmodule

export PATH=$PATH:/sbin:/usr/sbin:/bin:/usr/bin

case "$1" in
  configure)
    # The MariaDB Plugin needs access to the docker daemon to identify the servers
    adduser mysql docker
    ;;
  *)
    echo "postinst called with unknown argument '$1'" 1>&2
    exit 1
    ;;
esac

systemctl --system daemon-reload >/dev/null || true
if systemctl is-enabled mariadb.service >/dev/null
then
    deb-systemd-invoke restart mariadb.service >/dev/null || true
fi

#DEBHELPER#
